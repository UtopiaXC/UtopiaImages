{
  "name": "Utopia Images Demo",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.27-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [2983],
  "portsAttributes": {
    "2983": {
      "label": "Utopia Images",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm --prefix web install && npm --prefix web run build && go build -o UtopiaImages ./cmd/utopia_images",
  "postStartCommand": "./UtopiaImages"
}
