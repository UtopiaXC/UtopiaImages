{
  "name": "Utopia Images Demo",
  "image": "utopiaxc/utopia_images:latest",
  "forwardPorts": [2983],
  "portsAttributes": {
    "2983": {
      "label": "Utopia Images",
      "onAutoForward": "openBrowser"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/data,target=/app/data,type=bind"
  ],
  "containerEnv": {
    "TZ": "Asia/Shanghai"
  },
  "postStartCommand": "pgrep utopia_images || nohup /app/utopia_images > /app/data/utopia_images.log 2>&1 &"
}
